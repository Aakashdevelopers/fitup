<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top Arc Luminous Border Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="36dp"
                android:topRightRadius="36dp" />
            <solid android:color="#35FFFFFF" />
        </shape>
    </item>
    <!-- Main Sheet Fill -->
    <item android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="35dp"
                android:topRightRadius="35dp" />
            <gradient
                android:angle="270"
                android:startColor="#0D0819"
                android:centerColor="#07040E"
                android:endColor="#05030A"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Green Active Call Banner Overlay -->
    <include
        android:id="@+id/layout_active_call_banner"
        layout="@layout/layout_active_call_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_header_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/deep_navy"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_active_call_banner">

        <!-- Back Action Button -->
        <ImageButton
            android:id="@+id/btn_chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_text" />

        <!-- Friend Avatar Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chat_avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_chat_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_chat_avatar_initials"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_gradient_3"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="PR" />

            <View
                android:id="@+id/v_chat_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_online_badge"
                app:layout_constraintBottom_toBottomOf="@id/tv_chat_avatar_initials"
                app:layout_constraintEnd_toEndOf="@id/tv_chat_avatar_initials" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Display Name and Online Status -->
        <LinearLayout
            android:id="@+id/layout_user_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_chat_voice_call"
            app:layout_constraintStart_toEndOf="@id/chat_avatar_container"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_chat_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                tools:text="Prabal" />

            <TextView
                android:id="@+id/tv_chat_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/electric_blue"
                android:textSize="11sp"
                tools:text="Online" />

        </LinearLayout>

        <!-- Voice Call Action Button -->
        <ImageButton
            android:id="@+id/btn_chat_voice_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Call"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_call"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_chat_video_call"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/secondary_text" />

        <!-- Video Call Action Button -->
        <ImageButton
            android:id="@+id/btn_chat_video_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video Call"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_video_call"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/secondary_text" />

        <!-- Header Bottom Divider -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/subtle_border"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Message Timeline Feed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layout_chat_composer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chat_header_bar"
        tools:listitem="@layout/item_message_text_incoming" />

    <!-- Message Composer Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_chat_composer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#09182B"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Top Divider -->
        <View
            android:id="@+id/v_composer_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/nav_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Attachment / Gallery Action -->
        <ImageButton
            android:id="@+id/btn_chat_gallery"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Attach File"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_composer_divider"
            app:tint="@color/secondary_text" />

        <!-- Emoji Picker Action -->
        <ImageButton
            android:id="@+id/btn_chat_emoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Emoji Picker"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_emoji"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_chat_gallery"
            app:layout_constraintTop_toBottomOf="@id/v_composer_divider"
            app:tint="@color/secondary_text" />

        <!-- Text Input Field Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input_box"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_composer_input"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_chat_snap_shortcut"
            app:layout_constraintStart_toEndOf="@id/btn_chat_emoji"
            app:layout_constraintTop_toBottomOf="@id/v_composer_divider">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="Message..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_chat_send"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Send Action Button -->
            <ImageButton
                android:id="@+id/btn_chat_send"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send Message"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/primary_blue" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Private Snap Camera Shortcut Button -->
        <ImageButton
            android:id="@+id/btn_chat_snap_shortcut"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_snap_shortcut_btn"
            android:contentDescription="Send Private Snap"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_composer_divider"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

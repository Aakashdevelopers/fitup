<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_overlay_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="26dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/layout_overlay_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_template_resort_dark"
        android:orientation="vertical">

        <!-- Top Left White Translucent Pill Badge for Template 2 -->
        <TextView
            android:id="@+id/tv_overlay_top_left_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_pill_white_translucent"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="16%"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Template 1 Body Container -->
        <LinearLayout
            android:id="@+id/layout_overlay_template1_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Top Dots Indicator Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 3-Dots Indicator Overlay -->
                <LinearLayout
                    android:id="@+id/layout_overlay_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_indicator_active" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="6dp"
                        android:alpha="0.5"
                        android:background="@drawable/bg_indicator_active" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="6dp"
                        android:alpha="0.5"
                        android:background="@drawable/bg_indicator_active" />
                </LinearLayout>

                <!-- Tag View kept hidden for compatibility -->
                <TextView
                    android:id="@+id/tv_overlay_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_card_pill_dark"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LUXURY FIT NUTRITION"
                    android:textColor="#00F0FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Title & Kcal/Grade Pill Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_overlay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/tv_overlay_grade"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Grilled Chicken Bowl"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_card_pill_dark"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="520 kcal"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Subtitle / Description Text -->
            <TextView
                android:id="@+id/tv_overlay_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="FitBond Kitchen · Freshly prepared high protein meal portion."
                android:textColor="#A0B0C0"
                android:textSize="13sp" />

            <!-- Macro Stats Pills Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_overlay_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_pill_dark"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="42g Protein"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_carbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_pill_dark"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="55g Carbs"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_fat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_pill_dark"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="12g Fat"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Hidden image view for activity binding compatibility -->
                <ImageView
                    android:id="@+id/iv_overlay_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Hidden KCAL view for activity binding compatibility -->
                <TextView
                    android:id="@+id/tv_overlay_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Template 2 Overlay Body (Mini Thumbnail Box) -->
        <LinearLayout
            android:id="@+id/layout_overlay_template2_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_template2_bottom_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <!-- Small Square Thumbnail Image -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="#1A2433"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#30FFFFFF"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/iv_overlay_template2_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Thumbnail"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bg_sample_gym_preview" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <!-- Title & Subtitle Line -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_overlay_template2_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Grilled Chicken"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_overlay_template2_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="350g"
                            android:textColor="#90A4AE"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Stats / Macro Line -->
                    <TextView
                        android:id="@+id/tv_overlay_template2_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="520 kcal • 42g Protein"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Template 3 Overlay Body (Warm Bronze Stat Columns) -->
        <LinearLayout
            android:id="@+id/layout_overlay_template3_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <!-- Title & Subtitle + Right Icon Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/iv_overlay_template3_icon"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_overlay_template3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Grilled Chicken Bowl"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overlay_template3_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="FitBond Kitchen · 350g portion"
                        android:textColor="#C8B8AA"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_overlay_template3_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Icon"
                    android:src="@drawable/ic_flame"
                    app:tint="#D4AF37" />
            </RelativeLayout>

            <!-- Thin Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#25FFFFFF" />

            <!-- 3 Stat Columns Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Stat Column 1 (Calories) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat1_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="520"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat1_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Calories"
                        android:textColor="#A8988A"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Stat Column 2 (Protein) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat2_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42g"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat2_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Protein"
                        android:textColor="#A8988A"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Stat Column 3 (Grade/Score) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat3_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grade A"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overlay_template3_stat3_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Score"
                        android:textColor="#A8988A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Template 4 Overlay Body (Pinned Memo Note) -->
        <LinearLayout
            android:id="@+id/layout_overlay_template4_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Top Blue Push Pin -->
            <ImageView
                android:id="@+id/iv_overlay_template4_pin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="-10dp"
                android:elevation="4dp"
                android:contentDescription="Pin"
                android:src="@drawable/ic_pin_blue" />

            <!-- Inner Soft Blue Memo Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_template_memo_inner_box"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Number / Grade Tag -->
                <TextView
                    android:id="@+id/tv_overlay_template4_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01"
                    android:textColor="#2563EB"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Food Title -->
                <TextView
                    android:id="@+id/tv_overlay_template4_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Grilled Chicken Bowl"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Nutrition Description -->
                <TextView
                    android:id="@+id/tv_overlay_template4_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="520 KCAL • 42g Protein • 55g Carbs • 12g Fat\nFitBond Kitchen · Freshly prepared portion."
                    android:textColor="#475569"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Template 5 Overlay Body (Sunset Widget Calendar) -->
        <LinearLayout
            android:id="@+id/layout_overlay_template5_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Top Header Row: Segmented Tab + Settings Circle -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Segmented Tab Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_segmented_pill_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:id="@+id/tv_overlay_template5_tab1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MACROS"
                        android:textColor="#1E1B4B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overlay_template5_tab2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Daily Log"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Circle Flame Badge on Right -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="#20FFFFFF"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="Streak"
                        android:src="@drawable/ic_flame"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Main Title & Kcal Big Display -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_overlay_template5_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/tv_overlay_template5_kcal"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Grilled Chicken"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_template5_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="520"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Weekly Streak Day Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mon\n18"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tue\n19"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Wed\n20"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />

                <!-- Active Day Highlight Circle -->
                <TextView
                    android:id="@+id/tv_overlay_template5_active_day"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_streak_active_circle"
                    android:gravity="center"
                    android:text="21"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Fri\n22"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sat\n23"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sun\n24"
                    android:textColor="#E0E7FF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bottom Subtitle & Grade Pill Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tv_overlay_template5_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/tv_overlay_template5_grade_pill"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="✏ 42g P • 55g C • 12g F"
                    android:textColor="#F3E8FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_overlay_template5_grade_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_segmented_pill_white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Grade A ✨"
                    android:textColor="#1E1B4B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

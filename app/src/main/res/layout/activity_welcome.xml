<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_welcome_gradient"
    tools:context=".WelcomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/welcome_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Logo + App Name -->
        <LinearLayout
            android:id="@+id/welcome_brand_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_splash_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/welcome_brand_name"
                android:textColor="@color/text_primary_white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Onboarding Hero Section: Headline & Subtitle -->
        <LinearLayout
            android:id="@+id/welcome_hero_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_brand_block">

            <TextView
                android:id="@+id/tv_welcome_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_headline_full"
                android:textColor="@color/text_primary_white"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="4dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_welcome_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/text_secondary_blue"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Subtle Onboarding Indicator Dashes -->
        <LinearLayout
            android:id="@+id/indicator_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_hero_section">

            <!-- Active Indicator Dot/Dash -->
            <View
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_indicator_active" />

            <!-- Inactive Indicator Dot/Dash 1 -->
            <View
                android:layout_width="8dp"
                android:layout_height="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_indicator_inactive" />

            <!-- Inactive Indicator Dot/Dash 2 -->
            <View
                android:layout_width="8dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_indicator_inactive" />
        </LinearLayout>

        <!-- Bottom Actions Section -->
        <LinearLayout
            android:id="@+id/welcome_actions_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/indicator_container"
            app:layout_constraintVertical_bias="1.0">

            <!-- Primary Get Started Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_get_started"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_get_started"
                android:textColor="@color/text_primary_white"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/brand_cta_blue"
                app:cornerRadius="14dp"
                app:elevation="3dp"
                app:rippleColor="#40FFFFFF" />

            <!-- Secondary Log In Button / Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_login_action"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_login"
                android:textColor="@color/text_primary_white"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                app:rippleColor="#20FFFFFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>

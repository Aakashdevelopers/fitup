<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/snap_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".SnapPreviewActivity">

    <!-- 1. Media Preview Area (Full Screen Edge-to-Edge) -->
    <FrameLayout
        android:id="@+id/media_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/near_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Photo State View -->
        <ImageView
            android:id="@+id/iv_preview_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Snap Photo Preview"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sample_gym_preview" />

        <!-- Video State View -->
        <VideoView
            android:id="@+id/vv_preview_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Video Overlay Controls (Play/Pause, Timeline Progress, Duration) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/video_control_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Center Play/Pause Button -->
            <ImageButton
                android:id="@+id/btn_video_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_video_control_circle"
                android:src="@drawable/ic_play"
                android:contentDescription="Play or Pause Video"
                android:padding="16dp"
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bottom Video Playback Progress Bar & Time Bar -->
            <LinearLayout
                android:id="@+id/layout_video_progress_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ProgressBar
                    android:id="@+id/pb_video_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="35"
                    android:progressDrawable="@drawable/bg_primary_button" />

                <TextView
                    android:id="@+id/tv_video_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="00:05 / 00:15"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dynamic Text Caption Preview Layer (Placeholder for added text overlay) -->
        <TextView
            android:id="@+id/tv_caption_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#A606162E"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Leg Day Gains 🏋️‍♂️🔥"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- Top Overlay Shadow Gradient -->
    <View
        android:id="@+id/v_top_gradient"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_preview_top_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Top Navigation Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back / Close Button -->
        <ImageButton
            android:id="@+id/btn_back_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_circle"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/content_desc_back"
            android:padding="10dp"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Center Screen Title -->
        <TextView
            android:id="@+id/tv_preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_snap_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Right Lock Private Badge Indicator -->
        <LinearLayout
            android:id="@+id/layout_private_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_privacy_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Private Lock Icon"
                app:tint="@color/electric_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/privacy_badge_private"
                android:textColor="@color/light_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. Floating Media Editing Toolbar (Right Side) -->
    <LinearLayout
        android:id="@+id/layout_editing_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_editing_toolbar"
        android:paddingVertical="8dp"
        android:paddingHorizontal="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/top_nav_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Text Tool Icon -->
        <ImageButton
            android:id="@+id/btn_tool_text"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tool_text"
            android:contentDescription="@string/tool_text_label"
            android:padding="10dp"
            app:tint="@color/white" />

        <!-- Crop Tool Icon -->
        <ImageButton
            android:id="@+id/btn_tool_crop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tool_crop"
            android:contentDescription="@string/tool_crop_label"
            android:padding="10dp"
            app:tint="@color/white" />

        <!-- Drawing Pen Icon -->
        <ImageButton
            android:id="@+id/btn_tool_draw"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tool_draw"
            android:contentDescription="@string/tool_draw_label"
            android:padding="10dp"
            app:tint="@color/white" />

        <!-- Sticker / Emoji Icon -->
        <ImageButton
            android:id="@+id/btn_tool_sticker"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tool_sticker"
            android:contentDescription="@string/tool_sticker_label"
            android:padding="10dp"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Bottom Gradient Overlay -->
    <View
        android:id="@+id/v_bottom_gradient"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_preview_bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Bottom Action Section & Privacy Banner -->
    <LinearLayout
        android:id="@+id/bottom_action_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Privacy Identity Notice -->
        <LinearLayout
            android:id="@+id/layout_privacy_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_privacy_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Privacy Lock Icon"
                app:tint="@color/electric_blue" />

            <TextView
                android:id="@+id/tv_privacy_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/privacy_message_notice"
                android:textColor="@color/secondary_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Primary & Secondary CTA Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Discard Control (Circular Icon Button) -->
            <ImageButton
                android:id="@+id/btn_discard"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_discard_btn"
                android:src="@drawable/ic_trash"
                android:contentDescription="@string/content_desc_discard_snap"
                android:padding="14dp"
                app:tint="@color/logout_red" />

            <!-- Secondary Action: Retake Button -->
            <LinearLayout
                android:id="@+id/btn_retake"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_retake_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_retake"
                    android:contentDescription="Retake Camera Icon"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_retake"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Primary Action: Send To Friends Button (Single-line auto-scaled) -->
            <LinearLayout
                android:id="@+id/btn_send_to_friends"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_to_friends_btn"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/btn_send_to_friends"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="Send Arrow Icon"
                    app:tint="@color/white" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

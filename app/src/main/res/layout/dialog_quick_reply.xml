<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#14151B"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Quick Reply &amp; Decline"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_quick_reply_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="#8E8E93" />
    </RelativeLayout>

    <!-- Quick Reply Choices -->
    <TextView
        android:id="@+id/tv_reply_opt_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_row_selector"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:padding="16dp"
        android:text="Can't talk now. What's up?"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F212D" />

    <TextView
        android:id="@+id/tv_reply_opt_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_row_selector"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:padding="16dp"
        android:text="I'll call you right back."
        android:textColor="@color/white"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F212D" />

    <TextView
        android:id="@+id/tv_reply_opt_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_row_selector"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:padding="16dp"
        android:text="I'm on my way!"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F212D" />

    <TextView
        android:id="@+id/tv_reply_opt_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_row_selector"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:padding="16dp"
        android:text="Sorry, I'm in a meeting."
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>

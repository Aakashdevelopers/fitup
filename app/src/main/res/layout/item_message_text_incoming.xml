<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- Incoming Friend Circular Avatar -->
    <TextView
        android:id="@+id/tv_incoming_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_avatar_gradient_3"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/layout_bubble"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="K" />

    <!-- Incoming Message Bubble -->
    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_text_incoming_bubble"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_incoming_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Text Message Content -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:text="Come oooooonn 👻" />

        <!-- Timestamp & Status Container -->
        <LinearLayout
            android:id="@+id/layout_time_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                tools:text="12:45" />

            <ImageView
                android:id="@+id/iv_message_status"
                android:layout_width="15dp"
                android:layout_height="11dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_double_check"
                app:tint="#8E8E93" />

        </LinearLayout>

    </LinearLayout>

    <!-- Reaction Badges Overlapping Bottom of Bubble -->
    <LinearLayout
        android:id="@+id/layout_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-6dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/layout_bubble"
        app:layout_constraintTop_toBottomOf="@id/layout_bubble"
        tools:visibility="visible">

        <!-- Dynamic reaction pills -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- Incoming Friend Circular Avatar -->
    <TextView
        android:id="@+id/tv_incoming_avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_avatar_gradient_3"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/card_image_bubble"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="K" />

    <!-- 3D Photo Stack Container (Incoming) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_image_bubble"
        android:layout_width="270dp"
        android:layout_height="215dp"
        android:layout_marginStart="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_incoming_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Tilted Photo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_image_left"
            android:layout_width="135dp"
            android:layout_height="175dp"
            android:layout_marginStart="8dp"
            android:rotation="-12"
            app:cardBackgroundColor="#1A1A1E"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_image_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_avatar_gradient_3" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Right Tilted Photo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_image_right"
            android:layout_width="135dp"
            android:layout_height="175dp"
            android:layout_marginEnd="8dp"
            android:rotation="12"
            app:cardBackgroundColor="#1A1A1E"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_image_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_avatar_gradient_3" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Center Main Overlapping Photo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_image_center"
            android:layout_width="138dp"
            android:layout_height="180dp"
            app:cardBackgroundColor="#222226"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_message_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Received Photo"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/bg_avatar_gradient_3" />

                <!-- Multi-Photo Count Badge -->
                <TextView
                    android:id="@+id/tv_photo_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_photo_count_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="+10 photo"
                    tools:visibility="visible" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Translucent Timestamp & Status Badge -->
        <LinearLayout
            android:id="@+id/layout_time_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_time_pill"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                tools:text="13:18" />

            <ImageView
                android:id="@+id/iv_message_status"
                android:layout_width="14dp"
                android:layout_height="11dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_double_check"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Reaction Badges Below Stack -->
    <LinearLayout
        android:id="@+id/layout_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/card_image_bubble"
        app:layout_constraintTop_toBottomOf="@id/card_image_bubble"
        tools:visibility="visible">

        <!-- Dynamic reaction pills -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

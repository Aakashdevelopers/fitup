<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Incoming Image Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_image_bubble"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#16283D"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#253F63"
        app:strokeWidth="1dp"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_message_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Received Photo"
            android:scaleType="centerCrop"
            tools:src="@drawable/bg_avatar_gradient_3" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Message Timestamp Below Image -->
    <TextView
        android:id="@+id/tv_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/chat_time_text"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/card_image_bubble"
        app:layout_constraintTop_toBottomOf="@id/card_image_bubble"
        tools:text="10:45 AM" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/bg_floating_bottom_nav"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 4 Navigation Tabs Container -->
    <LinearLayout
        android:id="@+id/tabs_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Tab 1: Chat -->
        <FrameLayout
            android:id="@+id/tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/pill_chat"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_nav_selected_pill">

                <ImageView
                    android:id="@+id/iv_chat_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_chat"
                    android:contentDescription="@null"
                    app:tint="@color/nav_selected_item" />

                <TextView
                    android:id="@+id/tv_chat_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_chat"
                    android:textColor="@color/nav_selected_item"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 2: Camera -->
        <FrameLayout
            android:id="@+id/tab_camera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/pill_camera"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/iv_camera_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_camera"
                    android:contentDescription="@null"
                    app:tint="@color/nav_inactive_item" />

                <TextView
                    android:id="@+id/tv_camera_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_camera"
                    android:textColor="@color/nav_inactive_item"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 3: Post (Between Camera & Profile) -->
        <FrameLayout
            android:id="@+id/tab_post"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/pill_post"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/iv_post_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_post"
                    android:contentDescription="@null"
                    app:tint="@color/nav_inactive_item" />

                <TextView
                    android:id="@+id/tv_post_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_post"
                    android:textColor="@color/nav_inactive_item"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 4: Profile -->
        <FrameLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/pill_profile"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/iv_profile_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@null"
                    app:tint="@color/nav_inactive_item" />

                <TextView
                    android:id="@+id/tv_profile_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/nav_profile"
                    android:textColor="@color/nav_inactive_item"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>

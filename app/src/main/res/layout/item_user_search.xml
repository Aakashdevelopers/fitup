<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_chat_composer_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Avatar Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_user_search_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        app:shapeAppearanceOverlay="@style/CircularImageView" />

    <!-- Name & Username -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_user_search_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="Fe de Lamare" />

        <TextView
            android:id="@+id/tv_user_search_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            tools:text="\@fe" />
    </LinearLayout>

    <!-- Circular Action Button (+ / ✓) -->
    <ImageButton
        android:id="@+id/btn_user_add_friend"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_action_white"
        android:contentDescription="Add Friend"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_plus" />

</LinearLayout>

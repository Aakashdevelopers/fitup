<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Interactive Zoomable Image Viewer -->
    <com.amstudio.fitbond.ZoomableImageView
        android:id="@+id/zoomable_food_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Food Snap Image Viewer with Template Overlay" />

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/pb_image_viewer_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/electric_blue" />

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_preview_top_bar"
        android:elevation="10dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_close_image_viewer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_action_dark"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_viewer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Snap Viewer 🥗"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_viewer_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pinch or double-tap to zoom • Template Overlay Active"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_save_food_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_action_dark"
            android:contentDescription="Save Photo"
            android:padding="9dp"
            android:src="@drawable/ic_download"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Instruction Pill -->
    <LinearLayout
        android:id="@+id/layout_zoom_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_top_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_glass"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Double tap or pinch to zoom food &amp; template"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Action Controls -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_preview_bottom_bar"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_overlay"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="👁️ Overlay: ON"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_from_viewer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/online_green"
                android:text="Send Snap 🚀"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E2C"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Snap Options"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/btn_option_replay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Replay Snap"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btn_option_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Save in Chat"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btn_option_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Delete Snap"
        android:textColor="#FF5555"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Avatar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/avatar_container"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Optional Accent Ring -->
        <View
            android:id="@+id/view_chat_avatar_ring"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_active_friend_avatar_ring"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Avatar Initials / View -->
        <TextView
            android:id="@+id/tv_chat_avatar_initials"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_avatar_gradient_2"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MK" />

        <!-- Online Status Dot -->
        <View
            android:id="@+id/view_chat_online_dot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:background="@drawable/bg_online_badge"
            app:layout_constraintBottom_toBottomOf="@id/tv_chat_avatar_initials"
            app:layout_constraintEnd_toEndOf="@id/tv_chat_avatar_initials" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Call Actions (Voice & Video Call) Container -->
    <LinearLayout
        android:id="@+id/layout_item_call_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_item_voice_call"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Call"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_call"
            app:tint="@color/electric_blue" />

        <ImageButton
            android:id="@+id/btn_item_video_call"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video Call"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_video_call"
            app:tint="@color/electric_blue" />

    </LinearLayout>

    <!-- Last Message Timestamp -->
    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/chat_time_text"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/layout_item_call_actions"
        app:layout_constraintTop_toTopOf="@id/avatar_container"
        tools:text="10:42 AM" />

    <!-- Name and Gym Streak Indicator Container -->
    <LinearLayout
        android:id="@+id/layout_name_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/tv_chat_time"
        app:layout_constraintStart_toEndOf="@id/avatar_container"
        app:layout_constraintTop_toTopOf="@id/avatar_container">

        <!-- Friend Display Name -->
        <TextView
            android:id="@+id/tv_chat_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="16sp"
            tools:text="Marcus Vance" />

        <!-- Gym Streak Identity Indicator -->
        <LinearLayout
            android:id="@+id/layout_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_streak_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_flame" />

            <TextView
                android:id="@+id/tv_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#FF7A00"
                android:textSize="11sp"
                tools:text="12" />
        </LinearLayout>

    </LinearLayout>

    <!-- Unread Messages Badge -->
    <TextView
        android:id="@+id/tv_unread_badge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:minWidth="20dp"
        android:background="@drawable/bg_unread_badge"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/avatar_container"
        app:layout_constraintEnd_toStartOf="@id/layout_item_call_actions"
        android:layout_marginEnd="6dp"
        tools:text="2" />

    <!-- Last Message Preview Container (Supports Text & Snap Badges) -->
    <LinearLayout
        android:id="@+id/layout_last_message_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/tv_unread_badge"
        app:layout_constraintStart_toEndOf="@id/avatar_container"
        app:layout_constraintTop_toBottomOf="@id/layout_name_row">

        <!-- Snap Icon Preview (Camera or Video) -->
        <ImageView
            android:id="@+id/iv_last_message_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_camera"
            android:visibility="gone"
            app:tint="@color/electric_blue"
            tools:visibility="visible" />

        <!-- Last Message Preview Text -->
        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            tools:text="Snap" />

    </LinearLayout>

    <!-- Subtle Item Divider Line -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/nav_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/avatar_container" />

</androidx.constraintlayout.widget.ConstraintLayout>

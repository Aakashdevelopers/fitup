<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="60dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_post_share_bubble"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#171922"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Post Shared Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@null"
                    app:tint="@color/electric_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Shared Post"
                    android:textColor="@color/electric_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Post Thumbnail Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_post_share_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@drawable/bg_sample_gym_preview" />

            <!-- Post Title / Caption -->
            <TextView
                android:id="@+id/tv_post_share_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                tools:text="Workout post caption..." />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tv_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/secondary_text"
        android:textSize="10sp"
        tools:text="12:45 PM" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/snap_sent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".SnapSentConfirmationActivity">

    <!-- Scrollable Main Content Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Local UI Preview Banner Indicator -->
            <LinearLayout
                android:id="@+id/banner_local_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_local_preview_banner"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="@string/local_preview_notice"
                    app:tint="@color/electric_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/local_preview_notice"
                    android:textColor="@color/light_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Success Checkmark Header Icon -->
            <FrameLayout
                android:id="@+id/layout_success_icon_ring"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <!-- Outer Glowing Halo Ring -->
                <View
                    android:id="@+id/v_outer_glow_ring"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_success_circle_ring"
                    android:alpha="0.25" />

                <!-- Inner Gradient Circle -->
                <View
                    android:id="@+id/v_inner_gradient_circle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_success_circle_ring" />

                <!-- Success Checkmark Icon -->
                <ImageView
                    android:id="@+id/iv_success_check"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_success_check"
                    android:contentDescription="@string/snap_sent_title"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Success Main Heading -->
            <TextView
                android:id="@+id/tv_snap_sent_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/snap_sent_title"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Success Subtitle -->
            <TextView
                android:id="@+id/tv_snap_sent_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/snap_sent_subtitle"
                android:textColor="@color/secondary_text"
                android:textSize="14sp" />

            <!-- Sent Snap Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sent_snap_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/subtle_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_sent_snap_card"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tv_snap_card_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/badge_media_type"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/sent_snap_label"
                            android:textColor="@color/light_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Photo/Video Type Indicator Badge -->
                        <LinearLayout
                            android:id="@+id/badge_media_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_media_type_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_media_type_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_snap_video"
                                android:contentDescription="@string/photo_snap_label"
                                app:tint="@color/electric_blue" />

                            <TextView
                                android:id="@+id/tv_media_type_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/photo_snap_label"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Thumbnail Image Container maintaining Aspect Ratio -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/iv_sent_snap_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_sample_gym_preview"
                            android:contentDescription="@string/sent_snap_label" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recipients Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_recipients_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sent_to_header"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_recipient_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    tools:text="3 friends" />
            </LinearLayout>

            <!-- Selected Recipients Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sent_recipients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_sent_recipient" />

            <!-- Privacy Confirmation Notice -->
            <LinearLayout
                android:id="@+id/layout_privacy_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_sent_snap_card"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="@string/privacy_sent_notice"
                    app:tint="@color/electric_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/privacy_sent_notice"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/bottom_actions_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nav_bg"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primary Action: Back to Camera -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_camera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_back_to_camera"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_nav_camera"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- Secondary Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Secondary Button: Done -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_done"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/btn_done"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/chat_surface"
                app:cornerRadius="14dp"
                app:strokeColor="@color/subtle_border"
                app:strokeWidth="1dp" />

            <!-- Optional Text Action: Send Another Snap -->
            <TextView
                android:id="@+id/btn_send_another_snap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="12dp"
                android:text="@string/btn_send_another_snap"
                android:textColor="@color/electric_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

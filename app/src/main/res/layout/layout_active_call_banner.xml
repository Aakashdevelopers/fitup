<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_active_call_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_chat_composer_container"
    android:elevation="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Top Row: Avatar, Name, Call Info, Info (i) Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_banner_top_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Avatar Bubble Circle -->
        <FrameLayout
            android:id="@+id/layout_banner_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_active_friend_avatar_ring"
            android:padding="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_banner_avatar_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_gradient_3"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="sam" />
        </FrameLayout>

        <!-- Ongoing Call Title & Status/Duration -->
        <LinearLayout
            android:id="@+id/layout_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_banner_top_actions"
            app:layout_constraintStart_toEndOf="@id/layout_banner_avatar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_banner_call_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="sam" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_banner_call_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_video_call"
                    app:tint="#94A3B8" />

                <TextView
                    android:id="@+id/tv_banner_call_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="FitUp Video • 00:07" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Action Buttons Container (Dropdown Collapse & Info Expand) -->
        <LinearLayout
            android:id="@+id/layout_banner_top_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Dropdown Collapse/Expand Actions Toggle Button -->
            <ImageButton
                android:id="@+id/btn_banner_dropdown"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle action buttons"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_up"
                app:tint="#94A3B8" />

            <!-- Return / Info (i) Action Button -->

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Row: 4 Action Buttons (Speaker, Camera, Mute, End Call) -->
    <LinearLayout
        android:id="@+id/layout_banner_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_banner_top_row">

        <!-- Speaker Toggle Button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_banner_speaker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_btn_white"
                android:contentDescription="Toggle Speaker"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_speaker_on"
                app:tint="@color/black" />
        </FrameLayout>

        <!-- Camera Toggle Button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_banner_camera"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_btn_dark"
                android:contentDescription="Toggle Camera"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_call"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Mute Mic Toggle Button -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_banner_mute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_btn_dark"
                android:contentDescription="Toggle Mute"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_off"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- End Call / Hang Up Button (Red) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_banner_end_call"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_btn_red"
                android:contentDescription="End Call"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

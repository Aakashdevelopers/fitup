<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_profile_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/fl_reward_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_surface"
        android:padding="10dp">

        <ImageView
            android:id="@+id/iv_reward_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_streak_flame"
            app:tint="@color/streak_orange" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reward_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-bold"
            android:text="7-Day Iron Warrior 🏋️‍♂️" />

        <TextView
            android:id="@+id/tv_reward_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:text="Completed 7 consecutive workout days!" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_claim_reward"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="14dp"
        android:backgroundTint="@color/primary_blue"
        android:text="Claim"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:elevation="0dp" />

</LinearLayout>

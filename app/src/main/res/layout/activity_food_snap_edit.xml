<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_food_snap_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full Screen Captured Base Food Photo -->
    <ImageView
        android:id="@+id/iv_food_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Food Snap Photo"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_sample_gym_preview" />

    <!-- Interactive Touch Drag & Scale Area for Preview & Overlays -->
    <RelativeLayout
        android:id="@+id/container_card_drag_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- SVG Template Preview Card View -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_svg_template_root"
            android:layout_width="320dp"
            android:layout_height="400dp"
            android:layout_centerInParent="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_svg_template_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="SVG Template Live Preview"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- Top Edit Bar -->
    <RelativeLayout
        android:id="@+id/top_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back_snap_edit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_action_dark"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snap Card Editor"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Drag card • Pinch to scale"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"/>
    </RelativeLayout>

    <!-- Instruction Hint Badge -->
    <LinearLayout
        android:id="@+id/layout_drag_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_edit_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_glass"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drag card to move • Pinch to resize 👆"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Action Bar (Send Snap Button) -->
    <LinearLayout
        android:id="@+id/bottom_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_preview_bottom_bar"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- Final Export / Send Snap Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_edited_snap"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/primary_blue"
            android:text="Send Snap to Friends 🚀"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</RelativeLayout>
